# Database connection string
DATABASE_URI=mongodb://127.0.0.1/your-database-name

# Or use a PG connection string
#DATABASE_URI=postgresql://127.0.0.1:5432/your-database-name

# Used to encrypt JWT tokens
PAYLOAD_SECRET=YOUR_SECRET_HERE

# Used to configure CORS, format links and more. No trailing slash
NEXT_PUBLIC_SERVER_URL=http://localhost:3000

# Used only by the game seed and migration scripts. Public pages read the
# stored RAWG IDs and image URLs from MongoDB and do not call RAWG at runtime.
RAWG_API_KEY=
# Optional seed/sync window. Defaults to today through the end of next year.
RAWG_DATE_START=
RAWG_DATE_END=
# Optional pagination controls. The importer follows every page by default.
RAWG_PAGE_SIZE=40
RAWG_START_PAGE=1
RAWG_END_PAGE=
# Keep public imports curated by default. Set AUTO_PUBLISH=true only for a
# reviewed window or automation policy.
CLEAN_CATALOGUE=true
AUTO_PUBLISH=false

# Secret used to authenticate cron jobs
CRON_SECRET=YOUR_CRON_SECRET_HERE

# Used to validate preview requests
PREVIEW_SECRET=YOUR_SECRET_HERE
