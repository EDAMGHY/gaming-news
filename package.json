{
  "name": "gaming-news",
  "version": "1.0.0",
  "description": "Gaming publication powered by Payload CMS and Next.js",
  "license": "MIT",
  "type": "module",
  "packageManager": "pnpm@10.28.2",
  "scripts": {
    "build": "cross-env NODE_OPTIONS=--no-deprecation next build",
    "postbuild": "next-sitemap --config next-sitemap.config.cjs",
    "dev": "cross-env NODE_OPTIONS=--no-deprecation next dev",
    "dev:prod": "cross-env NODE_OPTIONS=--no-deprecation rm -rf .next && pnpm build && pnpm start",
    "generate:importmap": "cross-env NODE_OPTIONS=--no-deprecation payload generate:importmap",
    "generate:types": "cross-env NODE_OPTIONS=--no-deprecation payload generate:types",
    "ii": "cross-env NODE_OPTIONS=--no-deprecation pnpm --ignore-workspace install",
    "lint": "cross-env NODE_OPTIONS=--no-deprecation eslint .",
    "lint:fix": "cross-env NODE_OPTIONS=--no-deprecation eslint . --fix",
    "payload": "cross-env NODE_OPTIONS=--no-deprecation payload",
    "seed:games": "cross-env NODE_OPTIONS=--no-deprecation pnpm exec tsx scripts/seed-games.ts",
    "seed:editorial": "cross-env NODE_OPTIONS=--no-deprecation pnpm exec tsx scripts/seed-editorial-content.ts",
    "seed:content": "cross-env NODE_OPTIONS=--no-deprecation pnpm exec tsx scripts/seed-content.ts",
    "seed:about": "cross-env NODE_OPTIONS=--no-deprecation pnpm exec tsx scripts/seed-about.ts",
    "clean:duplicates": "cross-env NODE_OPTIONS=--no-deprecation pnpm exec tsx scripts/remove-duplicates.ts",
    "content:reset": "cross-env NODE_OPTIONS=--no-deprecation pnpm exec tsx scripts/reset-public-content.ts",
    "media:rawg:migrate": "cross-env NODE_OPTIONS=--no-deprecation pnpm exec tsx scripts/migrate-game-media-to-rawg.ts",
    "media:rawg:cleanup": "cross-env NODE_OPTIONS=--no-deprecation pnpm exec tsx scripts/migrate-game-media-to-rawg.ts --cleanup",
    "media:rawg:rollback": "cross-env NODE_OPTIONS=--no-deprecation pnpm exec tsx scripts/migrate-game-media-to-rawg.ts --rollback",
    "reinstall": "cross-env NODE_OPTIONS=--no-deprecation rm -rf node_modules && rm pnpm-lock.yaml && pnpm --ignore-workspace install",
    "start": "cross-env NODE_OPTIONS=--no-deprecation next start",
    "test": "pnpm run test:int && pnpm run test:e2e",
    "test:e2e": "cross-env NODE_OPTIONS=\"--no-deprecation --no-experimental-strip-types\" pnpm exec playwright test --config=playwright.config.ts",
    "test:int": "cross-env NODE_OPTIONS=--no-deprecation vitest run --config ./vitest.config.mts"
  },
  "dependencies": {
    "@payloadcms/admin-bar": "3.90.2",
    "@payloadcms/db-mongodb": "3.90.2",
    "@payloadcms/live-preview-react": "3.90.2",
    "@payloadcms/next": "3.90.2",
    "@payloadcms/payload-cloud": "3.90.2",
    "@payloadcms/plugin-form-builder": "3.90.2",
    "@payloadcms/plugin-nested-docs": "3.90.2",
    "@payloadcms/plugin-redirects": "3.90.2",
    "@payloadcms/plugin-search": "3.90.2",
    "@payloadcms/plugin-seo": "3.90.2",
    "@payloadcms/richtext-lexical": "3.90.2",
    "@payloadcms/ui": "3.90.2",
    "@radix-ui/react-accordion": "^1.2.16",
    "@radix-ui/react-checkbox": "^1.0.4",
    "@radix-ui/react-dialog": "^1.1.19",
    "@radix-ui/react-dropdown-menu": "^2.1.20",
    "@radix-ui/react-label": "^2.0.2",
    "@radix-ui/react-popover": "^1.1.19",
    "@radix-ui/react-progress": "^1.1.12",
    "@radix-ui/react-select": "^2.0.0",
    "@radix-ui/react-slot": "^1.0.2",
    "@radix-ui/react-tabs": "^1.1.17",
    "@radix-ui/react-toast": "^1.2.19",
    "@radix-ui/react-tooltip": "^1.2.12",
    "class-variance-authority": "^0.7.0",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "cross-env": "^7.0.3",
    "date-fns": "4.1.0",
    "dotenv": "16.4.7",
    "geist": "^1.3.0",
    "graphql": "^16.8.2",
    "lucide-react": "^0.475.0",
    "mongodb": "6.20.0",
    "next": "16.3.8",
    "next-sitemap": "^4.2.3",
    "node-fetch": "^3.3.2",
    "payload": "3.90.2",
    "prism-react-renderer": "^2.3.1",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-hook-form": "7.54.2",
    "react-icons": "^5.5.0",
    "sharp": "0.35.5",
    "swiper": "12.1.2",
    "tailwind-merge": "^2.3.0",
    "tailwindcss-animate": "^1.0.7"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.2.0",
    "@playwright/test": "1.55.1",
    "@tailwindcss/typography": "^0.5.13",
    "@testing-library/react": "16.3.0",
    "@types/escape-html": "^1.0.2",
    "@types/node": "22.12.0",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "4.5.2",
    "autoprefixer": "^10.4.19",
    "copyfiles": "^2.4.1",
    "eslint": "^9.16.0",
    "eslint-config-next": "16.3.8",
    "eslint-plugin-react-hooks": "7.1.1",
    "jsdom": "26.1.0",
    "playwright": "1.55.1",
    "playwright-core": "1.55.1",
    "postcss": "^8.4.38",
    "prettier": "^3.4.2",
    "tailwindcss": "^3.4.3",
    "tsx": "^4.23.1",
    "typescript": "5.7.3",
    "vite-tsconfig-paths": "5.1.4",
    "vitest": "3.2.3"
  },
  "engines": {
    "node": ">=22.12.0",
    "pnpm": "^9 || ^10"
  },
  "pnpm": {
    "overrides": {
      "@babel/helper-compilation-targets>browserslist": "4.28.7",
      "@payloadcms/email-nodemailer>nodemailer": "10.0.6",
      "@payloadcms/payload-cloud>amazon-cognito-identity-js": "6.3.21",
      "@payloadcms/payload-cloud>nodemailer": "10.0.6",
      "ajv>fast-uri": "3.1.7",
      "anymatch>picomatch": "2.3.2",
      "fast-xml-parser": "5.11.2",
      "json-schema-to-typescript>js-yaml": "4.3.2",
      "json-schema-to-typescript>lodash": "4.18.1",
      "micromatch>picomatch": "2.3.2",
      "payload>undici": "7.29.1",
      "payload>ws": "8.22.0",
      "postcss>nanoid": "3.3.18",
      "readdirp>picomatch": "2.3.2",
      "sass>immutable": "4.3.9",
      "sass>source-map-js": "1.2.2",
      "source-map-js": "1.2.2",
      "tailwindcss>postcss": "8.5.29",
      "tinyglobby>picomatch": "4.0.7"
    },
    "onlyBuiltDependencies": [
      "sharp",
      "esbuild",
      "unrs-resolver"
    ]
  }
}
